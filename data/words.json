{
  "version": 1,
  "dialect": "Northern (Hà Nội)",
  "topics": [
    "Introduce yourself",
    "Greet people",
    "Introduce family members",
    "Order drinks",
    "Talk to the waiter",
    "Discuss places"
  ],
  "words": [
    { "id": "w001", "vietnamese": "tôi", "english": "I, me", "topic": "Introduce yourself", "type": "pronoun", "example_vi": "Tên tôi là Minh.", "example_en": "My name is Minh.", "note": "Neutral, polite \"I\". With close friends people often say \"mình\".", "added": "2026-11-14" },
    { "id": "w002", "vietnamese": "là", "english": "to be (is, am, are)", "topic": "Introduce yourself", "type": "verb", "example_vi": "Tôi là sinh viên.", "example_en": "I am a student.", "note": "Links two nouns. Not used before adjectives: \"Tôi khỏe\" (I am well), not \"Tôi là khỏe\".", "added": "2026-11-14" },
    { "id": "w003", "vietnamese": "tên", "english": "name", "topic": "Introduce yourself", "type": "noun", "example_vi": "Tên tôi là Lan.", "example_en": "My name is Lan.", "added": "2026-11-14" },
    { "id": "w004", "vietnamese": "bạn", "english": "you (friend / same age); friend", "topic": "Introduce yourself", "type": "pronoun", "example_vi": "Bạn ấy là bạn của tôi.", "example_en": "He/She is my friend.", "note": "Used for people about your own age. For older or younger people use anh, chị, em, ông, bà, …", "added": "2026-11-14" },
    { "id": "w005", "vietnamese": "gì", "english": "what", "topic": "Introduce yourself", "type": "question word", "example_vi": "Bạn tên là gì?", "example_en": "What is your name?", "note": "Comes at the end of the question.", "added": "2026-11-14" },
    { "id": "w006", "vietnamese": "người", "english": "person, people", "topic": "Introduce yourself", "type": "noun", "example_vi": "Tôi là người Anh.", "example_en": "I am English.", "note": "người + country = nationality (người Việt Nam, người Mỹ, người Đức).", "added": "2026-11-14" },
    { "id": "w007", "vietnamese": "nào", "english": "which", "topic": "Introduce yourself", "type": "question word", "example_vi": "Bạn là người nước nào?", "example_en": "Which country are you from?", "added": "2026-11-14" },
    { "id": "w008", "vietnamese": "Việt Nam", "english": "Vietnam", "topic": "Introduce yourself", "type": "noun", "example_vi": "Tôi muốn đi Việt Nam.", "example_en": "I want to go to Vietnam.", "added": "2026-11-14" },
    { "id": "w009", "vietnamese": "tiếng Việt", "english": "Vietnamese (language)", "topic": "Introduce yourself", "type": "noun", "example_vi": "Tiếng Việt rất khó.", "example_en": "Vietnamese is very difficult.", "note": "tiếng + country = language (tiếng Anh, tiếng Đức, tiếng Pháp).", "added": "2026-11-14" },
    { "id": "w010", "vietnamese": "tiếng Anh", "english": "English (language)", "topic": "Introduce yourself", "type": "noun", "example_vi": "Bạn có nói tiếng Anh không?", "example_en": "Do you speak English?", "added": "2026-11-14" },
    { "id": "w011", "vietnamese": "học", "english": "to study, to learn", "topic": "Introduce yourself", "type": "verb", "example_vi": "Tôi học tiếng Việt mỗi ngày.", "example_en": "I study Vietnamese every day.", "added": "2026-11-14" },
    { "id": "w012", "vietnamese": "sinh viên", "english": "(university) student", "topic": "Introduce yourself", "type": "noun", "example_vi": "Em trai tôi là sinh viên.", "example_en": "My younger brother is a student.", "note": "A school pupil is \"học sinh\".", "added": "2026-11-14" },
    { "id": "w013", "vietnamese": "giáo viên", "english": "teacher", "topic": "Introduce yourself", "type": "noun", "example_vi": "Mẹ tôi là giáo viên.", "example_en": "My mother is a teacher.", "added": "2026-11-14" },
    { "id": "w014", "vietnamese": "bác sĩ", "english": "doctor", "topic": "Introduce yourself", "type": "noun", "example_vi": "Chị ấy là bác sĩ.", "example_en": "She is a doctor.", "added": "2026-11-14" },
    { "id": "w015", "vietnamese": "làm", "english": "to do, to work, to make", "topic": "Introduce yourself", "type": "verb", "example_vi": "Bạn làm nghề gì?", "example_en": "What do you do (for a living)?", "note": "nghề = profession, job.", "added": "2026-11-14" },
    { "id": "w016", "vietnamese": "sống", "english": "to live", "topic": "Introduce yourself", "type": "verb", "example_vi": "Tôi sống ở Hà Nội.", "example_en": "I live in Hanoi.", "added": "2026-11-14" },
    { "id": "w017", "vietnamese": "bao nhiêu tuổi", "english": "how old", "topic": "Introduce yourself", "type": "phrase", "example_vi": "Bạn bao nhiêu tuổi?", "example_en": "How old are you?", "note": "Answer: \"Tôi ba mươi tuổi\" (I am 30). For small children ask \"Cháu mấy tuổi?\".", "added": "2026-11-14" },
    { "id": "w018", "vietnamese": "có", "english": "to have; yes (in answers)", "topic": "Introduce yourself", "type": "verb", "example_vi": "Tôi có một em gái.", "example_en": "I have a younger sister.", "note": "In \"có … không?\" questions, \"có\" also means \"yes\".", "added": "2026-11-14" },
    { "id": "w019", "vietnamese": "không", "english": "no, not; question particle", "topic": "Introduce yourself", "type": "adverb", "example_vi": "Tôi không uống bia.", "example_en": "I don't drink beer.", "note": "At the end of a sentence it turns it into a yes/no question: \"Bạn có khỏe không?\"", "added": "2026-11-14" },
    { "id": "w020", "vietnamese": "chúng tôi", "english": "we (not including the listener)", "topic": "Introduce yourself", "type": "pronoun", "example_vi": "Chúng tôi là sinh viên.", "example_en": "We are students.", "note": "\"chúng ta\" = we, including the person you are talking to.", "added": "2026-11-14" },
    { "id": "w021", "vietnamese": "ấy", "english": "that (person) → he / she", "topic": "Introduce yourself", "type": "pronoun", "example_vi": "Anh ấy là bác sĩ.", "example_en": "He is a doctor.", "note": "Pronoun + ấy = he/she: anh ấy (he), chị ấy (she), bạn ấy (he/she, same age).", "added": "2026-11-14" },
    { "id": "w119", "vietnamese": "mình", "english": "I, me (casual)", "topic": "Introduce yourself", "type": "pronoun", "example_vi": "Mình tên là Lan.", "example_en": "My name is Lan. (casual)", "note": "Casual \"I\" between friends of about the same age, paired with \"bạn\". Use \"tôi\" in neutral or formal situations.", "added": "2026-11-14" },

    { "id": "w022", "vietnamese": "xin chào", "english": "hello (polite)", "topic": "Greet people", "type": "phrase", "example_vi": "Xin chào, tôi là Minh.", "example_en": "Hello, I am Minh.", "note": "Formal. In daily life people say \"chào\" + pronoun. To older people add \"ạ\": \"Cháu chào bà ạ.\"", "added": "2026-11-14" },
    { "id": "w023", "vietnamese": "chào", "english": "hi, hello, bye", "topic": "Greet people", "type": "verb", "example_vi": "Chào anh!", "example_en": "Hello! (to an older man)", "note": "Usually followed by a pronoun: chào anh, chào chị, chào em, chào bạn.", "added": "2026-11-14" },
    { "id": "w024", "vietnamese": "tạm biệt", "english": "goodbye", "topic": "Greet people", "type": "phrase", "example_vi": "Tạm biệt chị!", "example_en": "Goodbye! (to an older woman)", "added": "2026-11-14", "note": "Sounds a bit formal. In everyday Hanoi speech people say \"chào\" + pronoun for goodbye too; to older people add \"ạ\": \"Em chào chị ạ.\"" },
    { "id": "w025", "vietnamese": "hẹn gặp lại", "english": "see you again", "topic": "Greet people", "type": "phrase", "example_vi": "Tạm biệt, hẹn gặp lại!", "example_en": "Goodbye, see you again!", "added": "2026-11-14" },
    { "id": "w026", "vietnamese": "khỏe", "english": "healthy, well, fine", "topic": "Greet people", "type": "adjective", "example_vi": "Tôi khỏe, cảm ơn.", "example_en": "I'm fine, thank you.", "added": "2026-11-14" },
    { "id": "w027", "vietnamese": "bạn có khỏe không?", "english": "how are you?", "topic": "Greet people", "type": "phrase", "example_vi": "Chào chị, chị có khỏe không?", "example_en": "Hello, how are you? (to an older woman)", "note": "Replace \"bạn\" with the right pronoun (anh, chị, em, ông, bà). To older people add \"ạ\": \"Ông có khỏe không ạ?\"", "added": "2026-11-14" },
    { "id": "w028", "vietnamese": "cảm ơn", "english": "thank you", "topic": "Greet people", "type": "phrase", "example_vi": "Cảm ơn anh!", "example_en": "Thank you! (to an older man)", "added": "2026-11-14", "note": "To be polite to older people add \"ạ\": \"Cảm ơn anh ạ.\"" },
    { "id": "w029", "vietnamese": "không có gì", "english": "you're welcome", "topic": "Greet people", "type": "phrase", "example_vi": "– Cảm ơn bạn! – Không có gì.", "example_en": "– Thank you! – You're welcome.", "note": "Literally: \"it's nothing\".", "added": "2026-11-14" },
    { "id": "w030", "vietnamese": "xin lỗi", "english": "sorry; excuse me", "topic": "Greet people", "type": "phrase", "example_vi": "Xin lỗi, tôi không hiểu.", "example_en": "Sorry, I don't understand.", "added": "2026-11-14", "note": "Also \"excuse me\" to get attention. More polite with \"ạ\": \"Xin lỗi chị ạ.\"" },
    { "id": "w031", "vietnamese": "vâng", "english": "yes (polite)", "topic": "Greet people", "type": "particle", "example_vi": "Vâng, tôi hiểu.", "example_en": "Yes, I understand.", "note": "Polite \"yes\". In Hanoi people often say \"dạ\" or \"dạ vâng\" to elders, and add \"ạ\": \"Vâng ạ.\"", "added": "2026-11-14" },
    { "id": "w032", "vietnamese": "rất vui được gặp bạn", "english": "nice to meet you", "topic": "Greet people", "type": "phrase", "example_vi": "Chào chị, rất vui được gặp chị.", "example_en": "Hello, nice to meet you. (to an older woman)", "added": "2026-11-14" },
    { "id": "w033", "vietnamese": "anh", "english": "you (older man); older brother", "topic": "Greet people", "type": "pronoun", "example_vi": "Anh tên là gì?", "example_en": "What is your name? (to an older man)", "note": "For a man a bit older than you, or a man of similar age in polite situations.", "added": "2026-11-14" },
    { "id": "w034", "vietnamese": "chị", "english": "you (older woman); older sister", "topic": "Greet people", "type": "pronoun", "example_vi": "Chị có khỏe không?", "example_en": "How are you? (to an older woman)", "note": "For a woman a bit older than you, or a woman of similar age in polite situations.", "added": "2026-11-14" },
    { "id": "w035", "vietnamese": "em", "english": "you (younger person); younger sibling", "topic": "Greet people", "type": "pronoun", "example_vi": "Em tên là gì?", "example_en": "What is your name? (to a younger person)", "note": "Also used by the younger person to say \"I\" when talking to an older person.", "added": "2026-11-14" },
    { "id": "w036", "vietnamese": "ông", "english": "you (old man); grandfather; Mr.", "topic": "Greet people", "type": "pronoun", "example_vi": "Ông có khỏe không ạ?", "example_en": "How are you, sir? (polite)", "added": "2026-11-14", "note": "For a man of your grandparents' age; also \"Mr.\" Speak politely: add \"ạ\" at the end (\"Ông có khỏe không ạ?\") and call yourself \"cháu\"." },
    { "id": "w037", "vietnamese": "bà", "english": "you (old woman); grandmother; Mrs.", "topic": "Greet people", "type": "pronoun", "example_vi": "Bà tôi sống ở Hà Nội.", "example_en": "My grandmother lives in Hanoi.", "added": "2026-11-14", "note": "For a woman of your grandparents' age; also \"Mrs.\" Speak politely: add \"ạ\" at the end (\"Cháu chào bà ạ.\") and call yourself \"cháu\"." },
    { "id": "w038", "vietnamese": "ạ", "english": "(polite particle)", "topic": "Greet people", "type": "particle", "example_vi": "Cháu chào bà ạ.", "example_en": "Hello, grandma. (polite, from a young person)", "note": "Put at the end of a sentence to show respect to older people. Very common in Hanoi.", "added": "2026-11-14" },
    { "id": "w039", "vietnamese": "còn", "english": "and (what about …?); still", "topic": "Greet people", "type": "conjunction", "example_vi": "Tôi khỏe, còn bạn?", "example_en": "I'm fine, and you?", "added": "2026-11-14" },
    { "id": "w040", "vietnamese": "cũng", "english": "also, too", "topic": "Greet people", "type": "adverb", "example_vi": "Tôi cũng là sinh viên.", "example_en": "I am also a student.", "note": "Comes before the verb.", "added": "2026-11-14" },
    { "id": "w041", "vietnamese": "chúc ngủ ngon", "english": "good night", "topic": "Greet people", "type": "phrase", "example_vi": "Chúc em ngủ ngon!", "example_en": "Good night! (to a younger person)", "added": "2026-11-14" },
    { "id": "w120", "vietnamese": "cô", "english": "you (woman of your parents' age); aunt; female teacher", "topic": "Greet people", "type": "pronoun", "example_vi": "Cháu chào cô ạ.", "example_en": "Hello. (politely, to a woman of your parents' age)", "note": "For a woman around your parents' age, and how students address a female teacher. Call yourself \"cháu\" (or \"em\" to a teacher) and add \"ạ\".", "added": "2026-11-14" },
    { "id": "w121", "vietnamese": "chú", "english": "you (man of your parents' age); uncle", "topic": "Greet people", "type": "pronoun", "example_vi": "Chú có khỏe không ạ?", "example_en": "How are you? (politely, to a man of your parents' age)", "note": "For a man around your parents' age (younger than your father). Call yourself \"cháu\" and add \"ạ\".", "added": "2026-11-14" },
    { "id": "w122", "vietnamese": "dạ", "english": "yes (very polite)", "topic": "Greet people", "type": "particle", "example_vi": "Dạ, cháu hiểu ạ.", "example_en": "Yes, I understand. (very polite)", "note": "Respectful \"yes\" to older people or customers. Often combined: \"dạ vâng\".", "added": "2026-11-14" },

    { "id": "w042", "vietnamese": "gia đình", "english": "family", "topic": "Introduce family members", "type": "noun", "example_vi": "Gia đình tôi có bốn người.", "example_en": "There are four people in my family.", "added": "2026-11-14" },
    { "id": "w043", "vietnamese": "bố", "english": "father, dad", "topic": "Introduce family members", "type": "noun", "example_vi": "Đây là bố tôi.", "example_en": "This is my father.", "added": "2026-11-14" },
    { "id": "w044", "vietnamese": "mẹ", "english": "mother, mom", "topic": "Introduce family members", "type": "noun", "example_vi": "Mẹ tôi sống ở Hà Nội.", "example_en": "My mother lives in Hanoi.", "added": "2026-11-14" },
    { "id": "w045", "vietnamese": "anh trai", "english": "older brother", "topic": "Introduce family members", "type": "noun", "example_vi": "Anh trai tôi ba mươi tuổi.", "example_en": "My older brother is thirty years old.", "added": "2026-11-14" },
    { "id": "w046", "vietnamese": "chị gái", "english": "older sister", "topic": "Introduce family members", "type": "noun", "example_vi": "Chị gái tôi là bác sĩ.", "example_en": "My older sister is a doctor.", "added": "2026-11-14" },
    { "id": "w047", "vietnamese": "em trai", "english": "younger brother", "topic": "Introduce family members", "type": "noun", "example_vi": "Tôi có một em trai.", "example_en": "I have a younger brother.", "added": "2026-11-14" },
    { "id": "w048", "vietnamese": "em gái", "english": "younger sister", "topic": "Introduce family members", "type": "noun", "example_vi": "Em gái tôi mười tuổi.", "example_en": "My younger sister is ten years old.", "added": "2026-11-14" },
    { "id": "w049", "vietnamese": "anh chị em", "english": "siblings", "topic": "Introduce family members", "type": "noun", "example_vi": "Bạn có anh chị em không?", "example_en": "Do you have any siblings?", "added": "2026-11-14" },
    { "id": "w050", "vietnamese": "con", "english": "child (son/daughter)", "topic": "Introduce family members", "type": "noun", "example_vi": "Tôi có hai con.", "example_en": "I have two children.", "note": "Also a classifier for animals (con mèo = cat) and how children say \"I\" to their parents.", "added": "2026-11-14" },
    { "id": "w051", "vietnamese": "con trai", "english": "son; boy", "topic": "Introduce family members", "type": "noun", "example_vi": "Con trai tôi học tiếng Anh.", "example_en": "My son studies English.", "added": "2026-11-14" },
    { "id": "w052", "vietnamese": "con gái", "english": "daughter; girl", "topic": "Introduce family members", "type": "noun", "example_vi": "Đây là con gái tôi.", "example_en": "This is my daughter.", "added": "2026-11-14" },
    { "id": "w053", "vietnamese": "chồng", "english": "husband", "topic": "Introduce family members", "type": "noun", "example_vi": "Chồng tôi là người Việt Nam.", "example_en": "My husband is Vietnamese.", "added": "2026-11-14" },
    { "id": "w054", "vietnamese": "vợ", "english": "wife", "topic": "Introduce family members", "type": "noun", "example_vi": "Vợ tôi thích uống trà.", "example_en": "My wife likes to drink tea.", "added": "2026-11-14" },
    { "id": "w055", "vietnamese": "ông bà", "english": "grandparents", "topic": "Introduce family members", "type": "noun", "example_vi": "Ông bà tôi sống ở Hà Nội.", "example_en": "My grandparents live in Hanoi.", "added": "2026-11-14" },
    { "id": "w056", "vietnamese": "của", "english": "of, belonging to", "topic": "Introduce family members", "type": "preposition", "example_vi": "Đây là nhà của tôi.", "example_en": "This is my house.", "note": "Often dropped for family: \"mẹ tôi\" = \"mẹ của tôi\" (my mother).", "added": "2026-11-14" },
    { "id": "w057", "vietnamese": "đây", "english": "this (here)", "topic": "Introduce family members", "type": "pronoun", "example_vi": "Đây là anh trai tôi.", "example_en": "This is my older brother.", "added": "2026-11-14" },
    { "id": "w058", "vietnamese": "kia", "english": "that (over there)", "topic": "Introduce family members", "type": "pronoun", "example_vi": "Người kia là ai?", "example_en": "Who is that person?", "added": "2026-11-14" },
    { "id": "w059", "vietnamese": "ai", "english": "who", "topic": "Introduce family members", "type": "question word", "example_vi": "Đây là ai?", "example_en": "Who is this?", "added": "2026-11-14" },
    { "id": "w123", "vietnamese": "cháu", "english": "grandchild; niece, nephew; I (to elders)", "topic": "Introduce family members", "type": "pronoun", "example_vi": "Đây là cháu tôi.", "example_en": "This is my grandchild.", "note": "Young people call themselves \"cháu\" when talking to ông, bà, cô, chú: \"Cháu chào ông ạ.\"", "added": "2026-11-14" },

    { "id": "w060", "vietnamese": "cà phê", "english": "coffee", "topic": "Order drinks", "type": "noun", "example_vi": "Tôi thích cà phê Việt Nam.", "example_en": "I like Vietnamese coffee.", "added": "2026-11-14" },
    { "id": "w061", "vietnamese": "nâu đá", "english": "iced coffee with (condensed) milk", "topic": "Order drinks", "type": "noun", "example_vi": "Cho tôi một cốc nâu đá.", "example_en": "An iced milk coffee for me, please.", "note": "Hanoi term (\"brown + ice\"). Hot version: \"nâu nóng\".", "added": "2026-11-14" },
    { "id": "w062", "vietnamese": "cà phê đen", "english": "black coffee", "topic": "Order drinks", "type": "noun", "example_vi": "Anh ấy uống cà phê đen không đường.", "example_en": "He drinks black coffee without sugar.", "note": "In Hanoi also just \"đen đá\" (iced black coffee).", "added": "2026-11-14" },
    { "id": "w063", "vietnamese": "trà", "english": "tea", "topic": "Order drinks", "type": "noun", "example_vi": "Em ơi, cho anh hai cốc trà đá.", "example_en": "Excuse me, two iced teas please.", "note": "In the North tea is also called \"chè\" (careful: \"chè\" is also a sweet dessert soup). \"Trà đá\" = cheap street iced tea in Hanoi.", "added": "2026-11-14" },
    { "id": "w064", "vietnamese": "nước", "english": "water; country", "topic": "Order drinks", "type": "noun", "example_vi": "Cho tôi một cốc nước.", "example_en": "A glass of water for me, please.", "note": "Also means \"country\": \"Bạn là người nước nào?\" (Which country are you from?)", "added": "2026-11-14" },
    { "id": "w065", "vietnamese": "nước cam", "english": "orange juice", "topic": "Order drinks", "type": "noun", "example_vi": "Tôi muốn một cốc nước cam.", "example_en": "I want a glass of orange juice.", "added": "2026-11-14" },
    { "id": "w066", "vietnamese": "sữa", "english": "milk", "topic": "Order drinks", "type": "noun", "example_vi": "Con tôi uống sữa.", "example_en": "My child drinks milk.", "added": "2026-11-14" },
    { "id": "w067", "vietnamese": "đá", "english": "ice", "topic": "Order drinks", "type": "noun", "example_vi": "Cà phê này có đá không?", "example_en": "Does this coffee have ice?", "note": "Also means \"stone\" and \"to kick\".", "added": "2026-11-14" },
    { "id": "w068", "vietnamese": "đường", "english": "sugar; road", "topic": "Order drinks", "type": "noun", "example_vi": "Ít đường nhé!", "example_en": "Not much sugar, please!", "note": "Same word for \"road/street\". ít = a little.", "added": "2026-11-14" },
    { "id": "w069", "vietnamese": "bia", "english": "beer", "topic": "Order drinks", "type": "noun", "example_vi": "Cho anh hai chai bia.", "example_en": "Two bottles of beer for me, please.", "note": "\"Bia hơi\" = fresh draft beer, a Hanoi specialty. chai = bottle.", "added": "2026-11-14" },
    { "id": "w070", "vietnamese": "sinh tố", "english": "smoothie", "topic": "Order drinks", "type": "noun", "example_vi": "Tôi muốn một cốc sinh tố bơ.", "example_en": "I want an avocado smoothie.", "added": "2026-11-14" },
    { "id": "w071", "vietnamese": "nóng", "english": "hot", "topic": "Order drinks", "type": "adjective", "example_vi": "Trà này nóng quá!", "example_en": "This tea is too hot!", "note": "quá after an adjective = too / so.", "added": "2026-11-14" },
    { "id": "w072", "vietnamese": "lạnh", "english": "cold", "topic": "Order drinks", "type": "adjective", "example_vi": "Hôm nay trời lạnh.", "example_en": "It's cold today.", "added": "2026-11-14" },
    { "id": "w073", "vietnamese": "uống", "english": "to drink", "topic": "Order drinks", "type": "verb", "example_vi": "Bạn muốn uống gì?", "example_en": "What do you want to drink?", "added": "2026-11-14" },
    { "id": "w074", "vietnamese": "muốn", "english": "to want", "topic": "Order drinks", "type": "verb", "example_vi": "Tôi muốn uống cà phê.", "example_en": "I want to drink coffee.", "added": "2026-11-14" },
    { "id": "w075", "vietnamese": "cho", "english": "to give; for", "topic": "Order drinks", "type": "verb", "example_vi": "Cho tôi một cốc trà.", "example_en": "Give me a cup of tea, please.", "note": "\"Cho tôi …\" is the standard way to order.", "added": "2026-11-14" },
    { "id": "w076", "vietnamese": "cốc", "english": "glass, cup", "topic": "Order drinks", "type": "noun", "example_vi": "Một cốc cà phê, cảm ơn.", "example_en": "A cup of coffee, thank you.", "added": "2026-11-14" },
    { "id": "w077", "vietnamese": "một", "english": "one, a", "topic": "Order drinks", "type": "number", "example_vi": "Cho tôi một cốc nước cam.", "example_en": "An orange juice for me, please.", "added": "2026-11-14" },
    { "id": "w078", "vietnamese": "hai", "english": "two", "topic": "Order drinks", "type": "number", "example_vi": "Cho chúng tôi hai cốc bia.", "example_en": "Two glasses of beer for us, please.", "added": "2026-11-14" },
    { "id": "w079", "vietnamese": "ngon", "english": "delicious, tasty", "topic": "Order drinks", "type": "adjective", "example_vi": "Cà phê này rất ngon!", "example_en": "This coffee is very good!", "added": "2026-11-14" },
    { "id": "w080", "vietnamese": "thích", "english": "to like", "topic": "Order drinks", "type": "verb", "example_vi": "Tôi thích uống trà.", "example_en": "I like to drink tea.", "added": "2026-11-14" },
    { "id": "w081", "vietnamese": "rất", "english": "very", "topic": "Order drinks", "type": "adverb", "example_vi": "Nước cam rất ngon.", "example_en": "The orange juice is very good.", "note": "Comes before the adjective.", "added": "2026-11-14" },

    { "id": "w082", "vietnamese": "thực đơn", "english": "menu", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Em ơi, cho anh xem thực đơn.", "example_en": "Excuse me, can I see the menu?", "note": "Many places also just say \"menu\".", "added": "2026-11-14" },
    { "id": "w083", "vietnamese": "em ơi", "english": "excuse me! (calling a waiter)", "topic": "Talk to the waiter", "type": "phrase", "example_vi": "Em ơi, cho chị một cốc nước.", "example_en": "Excuse me, a glass of water please.", "note": "Used for younger staff. If the person is older: \"anh ơi\" / \"chị ơi\".", "added": "2026-11-14" },
    { "id": "w084", "vietnamese": "gọi món", "english": "to order (food)", "topic": "Talk to the waiter", "type": "verb", "example_vi": "Chúng tôi muốn gọi món.", "example_en": "We would like to order.", "added": "2026-11-14" },
    { "id": "w085", "vietnamese": "món", "english": "dish", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Món này là món gì?", "example_en": "What is this dish?", "added": "2026-11-14" },
    { "id": "w086", "vietnamese": "phở", "english": "pho (noodle soup)", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Cho tôi một bát phở bò.", "example_en": "A bowl of beef pho, please.", "note": "phở bò = beef pho, phở gà = chicken pho. Pho originated in the North.", "added": "2026-11-14" },
    { "id": "w087", "vietnamese": "bát", "english": "bowl", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Cho tôi thêm một bát cơm.", "example_en": "One more bowl of rice, please.", "added": "2026-11-14" },
    { "id": "w088", "vietnamese": "bún chả", "english": "grilled pork with rice noodles", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Bún chả Hà Nội rất ngon.", "example_en": "Hanoi bun cha is very delicious.", "note": "A famous Hanoi dish.", "added": "2026-11-14" },
    { "id": "w089", "vietnamese": "cơm", "english": "cooked rice; meal", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Tôi ăn cơm với gia đình.", "example_en": "I eat (a meal) with my family.", "added": "2026-11-14" },
    { "id": "w090", "vietnamese": "ăn", "english": "to eat", "topic": "Talk to the waiter", "type": "verb", "example_vi": "Bạn muốn ăn gì?", "example_en": "What do you want to eat?", "added": "2026-11-14" },
    { "id": "w091", "vietnamese": "tính tiền", "english": "the bill, please / to pay", "topic": "Talk to the waiter", "type": "phrase", "example_vi": "Em ơi, tính tiền!", "example_en": "Excuse me, the bill please!", "note": "Also \"thanh toán\" (to pay).", "added": "2026-11-14" },
    { "id": "w092", "vietnamese": "bao nhiêu tiền?", "english": "how much (does it cost)?", "topic": "Talk to the waiter", "type": "phrase", "example_vi": "Cái này bao nhiêu tiền?", "example_en": "How much is this?", "note": "tiền = money.", "added": "2026-11-14" },
    { "id": "w093", "vietnamese": "nghìn", "english": "thousand", "topic": "Talk to the waiter", "type": "number", "example_vi": "Năm mươi nghìn đồng.", "example_en": "Fifty thousand dong.", "added": "2026-11-14" },
    { "id": "w094", "vietnamese": "đồng", "english": "dong (Vietnamese currency)", "topic": "Talk to the waiter", "type": "noun", "example_vi": "Trà đá ba nghìn đồng một cốc.", "example_en": "Iced tea is three thousand dong a glass.", "added": "2026-11-14" },
    { "id": "w095", "vietnamese": "thêm", "english": "more; to add", "topic": "Talk to the waiter", "type": "verb", "example_vi": "Cho tôi thêm đá.", "example_en": "More ice, please.", "added": "2026-11-14" },
    { "id": "w096", "vietnamese": "cay", "english": "spicy", "topic": "Talk to the waiter", "type": "adjective", "example_vi": "Món này có cay không?", "example_en": "Is this dish spicy?", "note": "\"Không cay\" = not spicy.", "added": "2026-11-14" },
    { "id": "w097", "vietnamese": "một chút", "english": "a little, a moment", "topic": "Talk to the waiter", "type": "phrase", "example_vi": "Anh chờ một chút nhé.", "example_en": "Please wait a moment.", "note": "chờ / đợi = to wait.", "added": "2026-11-14" },
    { "id": "w098", "vietnamese": "nhé", "english": "(friendly particle: okay?, please)", "topic": "Talk to the waiter", "type": "particle", "example_vi": "Không đường nhé!", "example_en": "No sugar, okay?", "note": "Softens a request or suggestion.", "added": "2026-11-14" },

    { "id": "w099", "vietnamese": "ở", "english": "at, in; to be (located), to stay", "topic": "Discuss places", "type": "preposition", "example_vi": "Mẹ tôi ở nhà.", "example_en": "My mother is at home.", "added": "2026-11-14" },
    { "id": "w100", "vietnamese": "đâu", "english": "where", "topic": "Discuss places", "type": "question word", "example_vi": "Bạn sống ở đâu?", "example_en": "Where do you live?", "added": "2026-11-14" },
    { "id": "w101", "vietnamese": "Hà Nội", "english": "Hanoi", "topic": "Discuss places", "type": "noun", "example_vi": "Tôi thích Hà Nội.", "example_en": "I like Hanoi.", "added": "2026-11-14" },
    { "id": "w102", "vietnamese": "thành phố", "english": "city", "topic": "Discuss places", "type": "noun", "example_vi": "Hà Nội là một thành phố đẹp.", "example_en": "Hanoi is a beautiful city.", "added": "2026-11-14" },
    { "id": "w103", "vietnamese": "nhà", "english": "house, home", "topic": "Discuss places", "type": "noun", "example_vi": "Nhà tôi gần chợ.", "example_en": "My house is near the market.", "added": "2026-11-14" },
    { "id": "w104", "vietnamese": "nhà hàng", "english": "restaurant", "topic": "Discuss places", "type": "noun", "example_vi": "Nhà hàng này có phở ngon.", "example_en": "This restaurant has good pho.", "added": "2026-11-14" },
    { "id": "w105", "vietnamese": "quán cà phê", "english": "café, coffee shop", "topic": "Discuss places", "type": "noun", "example_vi": "Chúng ta đi quán cà phê nhé!", "example_en": "Let's go to a café!", "note": "quán = small shop / eatery (quán phở, quán bia).", "added": "2026-11-14" },
    { "id": "w106", "vietnamese": "trường", "english": "school", "topic": "Discuss places", "type": "noun", "example_vi": "Em gái tôi học ở trường này.", "example_en": "My younger sister studies at this school.", "note": "trường đại học = university.", "added": "2026-11-14" },
    { "id": "w107", "vietnamese": "bệnh viện", "english": "hospital", "topic": "Discuss places", "type": "noun", "example_vi": "Bố tôi làm ở bệnh viện.", "example_en": "My father works at a hospital.", "added": "2026-11-14" },
    { "id": "w108", "vietnamese": "khách sạn", "english": "hotel", "topic": "Discuss places", "type": "noun", "example_vi": "Khách sạn có xa không?", "example_en": "Is the hotel far?", "added": "2026-11-14" },
    { "id": "w109", "vietnamese": "chợ", "english": "market", "topic": "Discuss places", "type": "noun", "example_vi": "Mẹ tôi đi chợ.", "example_en": "My mother goes to the market.", "added": "2026-11-14" },
    { "id": "w110", "vietnamese": "công viên", "english": "park", "topic": "Discuss places", "type": "noun", "example_vi": "Công viên này rất đẹp.", "example_en": "This park is very beautiful.", "added": "2026-11-14" },
    { "id": "w111", "vietnamese": "nhà vệ sinh", "english": "toilet, restroom", "topic": "Discuss places", "type": "noun", "example_vi": "Xin lỗi, nhà vệ sinh ở đâu?", "example_en": "Excuse me, where is the toilet?", "added": "2026-11-14" },
    { "id": "w112", "vietnamese": "đẹp", "english": "beautiful, pretty", "topic": "Discuss places", "type": "adjective", "example_vi": "Hồ Hoàn Kiếm rất đẹp.", "example_en": "Hoan Kiem Lake is very beautiful.", "added": "2026-11-14" },
    { "id": "w113", "vietnamese": "to", "english": "big", "topic": "Discuss places", "type": "adjective", "example_vi": "Nhà hàng này rất to.", "example_en": "This restaurant is very big.", "note": "\"lớn\" also means big and is a bit more formal.", "added": "2026-11-14" },
    { "id": "w114", "vietnamese": "nhỏ", "english": "small", "topic": "Discuss places", "type": "adjective", "example_vi": "Quán cà phê này nhỏ nhưng đẹp.", "example_en": "This café is small but pretty.", "note": "In the North \"bé\" is also very common. nhưng = but.", "added": "2026-11-14" },
    { "id": "w115", "vietnamese": "gần", "english": "near, close", "topic": "Discuss places", "type": "adjective", "example_vi": "Khách sạn gần hồ.", "example_en": "The hotel is near the lake.", "added": "2026-11-14" },
    { "id": "w116", "vietnamese": "xa", "english": "far", "topic": "Discuss places", "type": "adjective", "example_vi": "Bệnh viện có xa không?", "example_en": "Is the hospital far?", "added": "2026-11-14" },
    { "id": "w117", "vietnamese": "hồ", "english": "lake", "topic": "Discuss places", "type": "noun", "example_vi": "Hồ Hoàn Kiếm ở Hà Nội.", "example_en": "Hoan Kiem Lake is in Hanoi.", "note": "Hanoi has many lakes: Hồ Hoàn Kiếm, Hồ Tây (West Lake).", "added": "2026-11-14" },
    { "id": "w118", "vietnamese": "đi", "english": "to go", "topic": "Discuss places", "type": "verb", "example_vi": "Bạn đi đâu đấy?", "example_en": "Where are you going?", "note": "\"đấy\" at the end makes the question sound casual and friendly.", "added": "2026-11-14" }
  ]
}
